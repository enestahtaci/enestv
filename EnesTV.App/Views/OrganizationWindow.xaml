<Window x:Class="EnesTV.App.Views.OrganizationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:EnesTV.App.Views" Style="{StaticResource {x:Type Window}}" Title="enestv · Kanal düzeni" Width="1080" Height="760" MinWidth="920" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Kanal düzeni" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Adları düzenle, kanalları sırala ve kendi favori listelerini oluştur. Değişiklikler Kaydet ile uygulanır." Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="GÖRÜNÜR KATEGORİLER" Margin="0,0,0,10"/><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="Tümü" Click="ShowAll_Click"/><Button Content="Hiçbiri" Click="HideAll_Click"/></StackPanel>
    <ListBox x:Name="CategoryList"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}" Margin="3,6"/></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><Button DockPanel.Dock="Right" Content="↑ Yukarı" Click="Up_Click"/><Button DockPanel.Dock="Right" Content="↓ Aşağı" Click="Down_Click"/><Button DockPanel.Dock="Right" Content="A → Z" Click="Sort_Click"/><TextBox x:Name="Search" TextChanged="Search_Changed" Margin="3" views:Hint.Text="Kanal adı, orijinal ad veya kategori ara…" AutomationProperties.Name="Düzenlenecek kanalları ara"/></DockPanel>
    <TextBlock Grid.Row="1" Text="İsim hücresine çift tıkla. Boş isim, sağlayıcının adını kullanır. Çoklu seçim: Ctrl / Shift." Foreground="{DynamicResource Muted}" Margin="3,8" FontSize="11"/>
    <DataGrid x:Name="RowsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" RowHeight="36" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}" RowBackground="{DynamicResource Panel}" AlternatingRowBackground="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" GridLinesVisibility="None" HeadersVisibility="Column">
     <DataGrid.Resources>
      <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
      <!-- Cells: vertically centred content on a plain background (the default template top-aligns it). -->
      <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
       <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger></Style.Triggers></Style>
      <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Margin" Value="10,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
      <Style x:Key="CellEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/></Style>
      <!-- App check box without the label column, centred in the cell; the column's default style would show the system box. -->
      <Style x:Key="CellCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Margin" Value="0"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Muted}" Background="{DynamicResource Surface}"><Path x:Name="Tick" Data="M3,8 L7,12 14,4" Stroke="{DynamicResource Accent}" StrokeThickness="2" Visibility="Collapsed"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
      <Style x:Key="CellCheckReadOnly" TargetType="CheckBox" BasedOn="{StaticResource CellCheck}"><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/></Style>
     </DataGrid.Resources>
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Header="Göster" Binding="{Binding Visible,UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource CellCheck}" EditingElementStyle="{StaticResource CellCheck}"/>
      <DataGridTextColumn Header="Görünen ad" Binding="{Binding Name,UpdateSourceTrigger=PropertyChanged}" Width="*" ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}"/>
      <DataGridTextColumn Header="Orijinal ad" Binding="{Binding OriginalName}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource CellText}"/>
      <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" IsReadOnly="True" Width="170" ElementStyle="{StaticResource CellText}"/>
      <DataGridCheckBoxColumn Header="Listede" Binding="{Binding InList,Mode=OneWay}" IsReadOnly="True" Width="70" ElementStyle="{StaticResource CellCheckReadOnly}"/>
     </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="{DynamicResource Surface}" Padding="12" CornerRadius="8" Margin="0,12,0,0"><StackPanel>
     <TextBlock Text="ÖZEL FAVORİ LİSTELERİ" FontSize="11" Margin="0,0,0,8"/>
     <DockPanel><Button DockPanel.Dock="Right" Content="Sil" Click="DeleteList_Click" Style="{StaticResource RaisedButton}"/><Button DockPanel.Dock="Right" Content="Adı değiştir" Click="RenameList_Click" Style="{StaticResource RaisedButton}"/><Button DockPanel.Dock="Right" Content="Yeni liste" Click="NewList_Click" Style="{StaticResource RaisedButton}"/><ComboBox x:Name="Lists" DisplayMemberPath="Name" SelectionChanged="Lists_Changed" MinWidth="140" Margin="0,3,6,3"/></DockPanel>
     <DockPanel Margin="0,7,0,0"><Button Content="Seçilenleri ekle" Click="AddMembers_Click" Style="{StaticResource RaisedButton}"/><Button Content="Seçilenleri çıkar" Click="RemoveMembers_Click" Style="{StaticResource RaisedButton}"/><TextBlock x:Name="Membership" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="10,0"/></DockPanel>
    </StackPanel></Border>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Vazgeç" IsCancel="True"/><Button x:Name="SaveButton" Content="Kaydet" Click="Save_Click" Background="{DynamicResource AccentSurface}" Foreground="{DynamicResource Accent}"/></StackPanel><TextBlock x:Name="Result" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel>
 </Grid>
</Window>
