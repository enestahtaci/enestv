<Window Style="{StaticResource {x:Type Window}}" x:Class="EnesTV.App.Views.GuideWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="enestv · TV rehberi" MinWidth="780" MinHeight="580" Width="970" Height="720" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <TextBlock Text="TV rehberi" FontSize="28" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Rehberi güncelle" HorizontalAlignment="Right" Click="Refresh_Click"/>
  <TextBox Grid.Row="1" x:Name="Search" AutomationProperties.Name="Rehberde kanal ara" TextChanged="Search_Changed" Margin="0,20,18,15" ToolTip="Kanal ara"/><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,20,0,15"><TextBlock Text="Gün" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="Day" AutomationProperties.Name="Rehber günü" SelectedDateChanged="Day_Changed" Width="150"/><TextBlock Text="Yerel saat" Foreground="{DynamicResource Muted}" Margin="15,0" VerticalAlignment="Center"/></StackPanel>
  <ListBox x:Name="Channels" Grid.Row="2" SelectionChanged="Channel_Changed" Margin="0,0,18,0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Padding="12,10" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Grid Grid.Row="2" Grid.Column="1"><ListBox x:Name="Programmes"><ListBox.ItemTemplate><DataTemplate><Border Padding="18" CornerRadius="10" Background="{DynamicResource Panel}"><StackPanel><TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,7"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="Empty" Text="Bir kanal ve gün seçin." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
 </Grid>
</Window>

