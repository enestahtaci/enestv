<Window Style="{StaticResource {x:Type Window}}" x:Class="EnesTV.App.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="enestv · Ayarlar" MinWidth="700" Width="850" Height="750" MinHeight="640" WindowStartupLocation="CenterOwner">
 <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="Ayarlar" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Görünüm, oynatma ve kaynaklarını yönet." Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="20"><StackPanel>
   <TextBlock Text="Görünüm ve oynatma" FontSize="17" FontWeight="SemiBold"/>
   <Grid Margin="0,14,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Tema" Margin="0,0,0,7"/><ComboBox x:Name="ThemeChoice" AutomationProperties.Name="Tema"><ComboBoxItem Content="Koyu"/><ComboBoxItem Content="Açık"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Varsayılan ses düzeyi"/><Slider x:Name="DefaultVolume" AutomationProperties.Name="Varsayılan ses düzeyi" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,16"/><TextBlock Text="{Binding Value,ElementName=DefaultVolume,StringFormat={}{0:0}%}"/></StackPanel></Grid>
   <CheckBox x:Name="AutoReconnect" Content="Yayın kesildiğinde otomatik yeniden bağlan (en fazla 3 deneme)"/>
   </StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="20" Margin="0,14,0,0"><StackPanel>
   <TextBlock Text="TV rehberi" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="XMLTV URL (.xml veya .xml.gz)" Margin="0,12,0,7"/><TextBox x:Name="EpgUrl" AutomationProperties.Name="TV rehberi adresi"/>
   <DockPanel Margin="0,10"><Button Content="Kaydet ve rehberi güncelle" Click="Epg_Click" DockPanel.Dock="Right"/><TextBlock Text="{Binding EpgStatus}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
   </StackPanel></Border><Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="20" Margin="0,14,0,0"><StackPanel>
   <TextBlock Text="Kaynaklar ve hesaplar" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Height="155"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource Panel}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdatedLabel,StringFormat=Son güncelleme: {0}}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
   <WrapPanel><Button Content="＋ Ekle" Click="Add_Click"/><Button Content="Düzenle" Click="Edit_Click"/><Button Content="Adını değiştir" Click="Rename_Click"/><Button Content="Yenile" Command="{Binding RefreshCommand}"/><Button Content="Sil" Click="Delete_Click"/></WrapPanel>
  </StackPanel></Border></StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><DockPanel Margin="0,12,0,0"><Button Content="Kaydet" Click="Save_Click" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"/><Button Content="Yüklemeyi iptal et" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel></StackPanel>
 </Grid>
</Window>

