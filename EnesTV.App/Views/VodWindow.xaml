<Window x:Class="EnesTV.App.Views.VodWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:views="clr-namespace:EnesTV.App.Views" Style="{StaticResource {x:Type Window}}" Title="enestv · Filmler ve diziler" Width="1450" Height="940" MinWidth="1100" MinHeight="760" WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_KeyDown">
 <Grid x:Name="Root" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <DockPanel x:Name="Header" Grid.ColumnSpan="3" Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="← Canlı TV'ye dön" Click="Back_Click"/><TextBlock Text="enestv" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="30"/><Button x:Name="MoviesButton" Content="Filmler" Click="Movies_Click" Margin="24,0,3,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsMovie}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="SeriesButton" Content="Diziler" Click="Series_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSeries}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="Film ve dizi kütüphanen" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0"/></DockPanel>
  <Border x:Name="CatalogPanel" Grid.Row="1" Background="{DynamicResource Panel}" Padding="14" CornerRadius="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right"  Command="{Binding RefreshCommand}" ToolTip="Kataloğu yenile" Style="{StaticResource IconButton}" AutomationProperties.Name="Yenile"><views:Icon Kind="Refresh" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><ComboBox x:Name="AccountChoice" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Name" ToolTip="Xtream hesabı"/></DockPanel>
   <Grid Grid.Row="1"><TextBox x:Name="CatalogSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="İçerik adına göre ara" AutomationProperties.Name="Film veya dizi ara" Margin="0,10"/><TextBlock Text="Film veya dizi ara…" Margin="12,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <ComboBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" ToolTip="Kategori"/>
   <DockPanel Grid.Row="3" Margin="2,12"><TextBlock Text="{Binding CountText}"/><Button DockPanel.Dock="Right" Content="İptal" Command="{Binding CancelCommand}" Padding="8,2" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel>
   <ListBox x:Name="CatalogList" Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
    <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="55" Height="80" Background="{DynamicResource Surface}" CornerRadius="5"><Grid><views:Icon Kind="Play" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><views:LazyLogo Url="{Binding Poster}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Grid>
   </DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="4" Margin="20" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><views:Icon Kind="Search" Width="30" Height="30" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/><TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
  </Grid></Border>
  <Grid x:Name="ContentPanel" Grid.Row="1" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="140"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="150" MaxHeight="255"/></Grid.RowDefinitions>
   <Border x:Name="VideoFrame" Background="#050608" CornerRadius="12"><vlc:VideoView x:Name="Video" MediaPlayer="{Binding Playback.Player}"><Grid x:Name="VideoOverlay" Background="Transparent" Focusable="True" MouseMove="Overlay_MouseMove" PreviewKeyDown="Window_KeyDown">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding ShowPlayerHint,Converter={StaticResource BoolVisibility}}" Margin="24"><views:Icon Kind="Play" Width="40" Height="40" Foreground="#B3F36B" HorizontalAlignment="Center"/><TextBlock Text="Sırada ne var?" FontSize="24" Foreground="#F3F5F7" TextAlignment="Center" Margin="0,14,0,8"/><TextBlock Text="Katalogdan seç, detaylarına bak ve izlemeye başla." TextWrapping="Wrap" TextAlignment="Center" Foreground="#A3ADBC"/></StackPanel>
    <Border x:Name="PlaybackErrorCard" Visibility="{Binding PlaybackError,Converter={StaticResource BoolVisibility}}" Background="#F0191D24" CornerRadius="12" Padding="20" Margin="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Yayın açılamadı" Foreground="#FFB899" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding PlaybackText}" Foreground="#F3F5F7" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16"/><Button Content="Yeniden dene" Command="{Binding PlayCommand}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/></StackPanel></Border><Border x:Name="OverlayControls" VerticalAlignment="Bottom" Margin="24" Background="#EE191D24" CornerRadius="12" Padding="16" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="{Binding PlayingName}" TextTrimming="CharacterEllipsis" Foreground="#F3F5F7" Margin="0,0,0,8"/>
     <Slider x:Name="FullSeek" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position,Mode=TwoWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp" LostMouseCapture="Seek_LostCapture" IsMoveToPointEnabled="True" AutomationProperties.Name="Tam ekran oynatma konumu"/>
     <DockPanel Margin="0,8,0,0"><Button Content="−10 sn" Click="Rewind_Click"/><Button  Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" Style="{StaticResource IconButton}" ToolTip="Oynat / duraklat" AutomationProperties.Name="Oynat / duraklat"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Content="+10 sn" Click="Forward_Click"/><Button Content="Sonraki bölüm" Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasNextEpisode}"/><TextBlock Text="{Binding TimeText}" Foreground="#F3F5F7" VerticalAlignment="Center" Margin="10,0"/><CheckBox Content="Sessiz" IsChecked="{Binding Muted}" Foreground="#F3F5F7" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Width="100" Value="{Binding Volume}" VerticalAlignment="Center"/><Button  Click="Fullscreen_Click" HorizontalAlignment="Right" Style="{StaticResource IconButton}" ToolTip="Tam ekrandan çık (Esc)" AutomationProperties.Name="Tam ekrandan çık (Esc)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button></DockPanel>
    </StackPanel></Border>
   </Grid></vlc:VideoView></Border>
   <StackPanel x:Name="PlayerControls" Grid.Row="1" Margin="0,12,0,12">
    <TextBlock Text="{Binding PlayingName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,5"><TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"/><TextBlock Text="{Binding PlaybackText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding PlaybackError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DockPanel>
    <Slider x:Name="Seek" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position,Mode=TwoWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp" LostMouseCapture="Seek_LostCapture" IsMoveToPointEnabled="True" AutomationProperties.Name="Oynatma konumu"/>
    <WrapPanel Margin="0,8,0,0"><Button Content="−10 sn" Click="Rewind_Click"/><Button  Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" Style="{StaticResource IconButton}" ToolTip="Oynat / duraklat" AutomationProperties.Name="Oynat / duraklat"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button  Command="{Binding StopCommand}" Style="{StaticResource IconButton}" ToolTip="Durdur" AutomationProperties.Name="Durdur"><views:Icon Kind="Stop" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Content="+10 sn" Click="Forward_Click"/><CheckBox Content="Sessiz" IsChecked="{Binding Muted}" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Width="85" Value="{Binding Volume}" VerticalAlignment="Center"/><Button x:Name="FullscreenButton"  Click="Fullscreen_Click" ToolTip="Tam ekran (F11)" Style="{StaticResource IconButton}" AutomationProperties.Name="Tam ekran (F11)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Content="Sonraki bölüm →" Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasNextEpisode}"/></WrapPanel>
    <Expander Header="Ses ve altyazı" Margin="0,4,0,0"><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="Audio" DisplayMemberPath="Name" ToolTip="Ses izi" SelectionChanged="Audio_Changed" Margin="0,0,5,0"/><ComboBox x:Name="Subtitles" Grid.Column="1" DisplayMemberPath="Name" ToolTip="Altyazı izi" SelectionChanged="Subtitles_Changed"/></Grid></Expander>
   </StackPanel>
   <Border x:Name="DetailsPanel" Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="12" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="250"/><Style.Triggers><DataTrigger Binding="{Binding IsMovie}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,15,0">
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding ResumeLabel}" Foreground="{DynamicResource Accent}" Margin="0,4"/><WrapPanel><Button x:Name="WatchButton" Content="İzle / devam et" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" Style="{StaticResource PrimaryButton}" Padding="14,8"/><Button Content="Baştan başlat" Command="{Binding RestartCommand}" IsEnabled="{Binding CanPlay}" Padding="9,8"/></WrapPanel></StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Detail.Name,TargetNullValue=Katalogdan bir içerik seçin}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail.Summary}" Foreground="{DynamicResource Muted}" Margin="0,6" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding DetailBusy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Detail.Plot}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding EpisodePlot}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
    </DockPanel>
    <Grid Grid.Column="1" Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Sezon" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding Season}"/></DockPanel><ListBox x:Name="EpisodeList" Grid.Row="1" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="5,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </Grid></Border>
  </Grid>
  <DockPanel x:Name="StatusPanel" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"><ProgressBar IsIndeterminate="True" Width="60" Height="3" Margin="0,0,10,0" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</Window>
