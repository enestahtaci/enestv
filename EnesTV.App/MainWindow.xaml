<Window Style="{StaticResource {x:Type Window}}" x:Class="EnesTV.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" xmlns:views="clr-namespace:EnesTV.App.Views" Title="enestv" Width="1480" Height="900" MinWidth="1120" MinHeight="730" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3,2"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Style>
  <!-- Mode switches. Never combine with DataContext="{Binding Vod}" on the same element: the trigger reads MainViewModel.IsVod. -->
  <Style x:Key="LiveOnly" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding IsVod}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="VodOnly" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVod}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid x:Name="RootGrid" Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Top"><TextBlock Text="enestv" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="SENİN EKRANIN." FontSize="10" Foreground="{DynamicResource Muted}" Margin="1,2,0,0"/></StackPanel>
  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,15"><TextBlock Text="{Binding SectionTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding SectionDescription}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
  <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Dosya aç" Click="OpenFile_Click"/><Button Content="+ Kaynak ekle" Click="AddSource_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>

  <!-- Sidebar -->
  <Grid Grid.Row="1" Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="KÜTÜPHANE" Foreground="{DynamicResource Muted}" FontSize="10" Margin="16,8,0,12"/>
    <Button AutomationProperties.Name="Canlı TV" Command="{Binding NavigateCommand}" CommandParameter="Live TV"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Tv" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Canlı TV" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Live TV"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button AutomationProperties.Name="Favoriler" Command="{Binding NavigateCommand}" CommandParameter="Favorites"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Star" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Favoriler" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Favorites"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button AutomationProperties.Name="Son izlenenler" Command="{Binding NavigateCommand}" CommandParameter="Recent"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Clock" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Son izlenenler" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Recent"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button AutomationProperties.Name="Kategoriler" Command="{Binding NavigateCommand}" CommandParameter="Categories"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Grid" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Kategoriler" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Categories"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <TextBlock Text="KEŞFET" Foreground="{DynamicResource Muted}" FontSize="10" Margin="16,14,0,8"/>
    <Button x:Name="MoviesNav" AutomationProperties.Name="Filmler" Command="{Binding NavigateCommand}" CommandParameter="Movies"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Play" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Filmler" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Movies"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Button x:Name="SeriesNav" AutomationProperties.Name="Diziler" Command="{Binding NavigateCommand}" CommandParameter="Series"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Series" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Diziler" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Nav}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Series"><Setter Property="Background" Value="{DynamicResource AccentSurface}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
    <Border Height="1" Background="{DynamicResource Line}" Margin="14,12,14,8"/><Button AutomationProperties.Name="Kanal düzeni" Click="Organization_Click" Style="{StaticResource Nav}"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="List" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Kanal düzeni" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content></Button><Button AutomationProperties.Name="Kısayollar" Click="Shortcuts_Click" Style="{StaticResource Nav}"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Keyboard" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Kısayollar" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content></Button>
    <Button AutomationProperties.Name="TV rehberi" Click="Guide_Click" Style="{StaticResource Nav}"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Guide" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="TV rehberi" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content></Button>
   </StackPanel></ScrollViewer>
   <StackPanel Grid.Row="1"><Button AutomationProperties.Name="Ayarlar" Click="Settings_Click" Style="{StaticResource Nav}"><Button.Content><StackPanel Orientation="Horizontal"><views:Icon Kind="Settings" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/><TextBlock Text="Ayarlar" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button.Content></Button></StackPanel>
  </Grid>

  <!-- Middle column: live channel list or movie/series catalog -->
  <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,20,0">
   <Border Style="{StaticResource LiveOnly}" Background="{DynamicResource Panel}" CornerRadius="14" Padding="16">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><TextBlock Text="{Binding ChannelCount}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="KANALLAR" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" FontSize="11" VerticalAlignment="Center"/></DockPanel>
     <Grid Grid.Row="1"><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kanal veya kategori ara" Padding="30,11,12,11"/><views:Icon Kind="Search" Width="16" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="Kanal veya kategori ara" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <ComboBox x:Name="CategoryChoice" Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,10" AutomationProperties.Name="Kategori"/>
     <StackPanel Grid.Row="3"><ComboBox ItemsSource="{Binding FavoriteLists}" SelectedItem="{Binding SelectedFavoriteList}" DisplayMemberPath="Name" Margin="0,0,0,10"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Favorites"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox><TextBlock Text="KANAL · ŞU ANDA YAYINDA" Foreground="{DynamicResource Muted}" FontSize="9" Margin="4,5,0,12"/></StackPanel>
     <ListBox x:Name="ChannelList" Grid.Row="4" ItemsSource="{Binding Channels}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate><DataTemplate><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
       <Button Command="{Binding DataContext.PlayCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Padding="6,9" Margin="0" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource Surface}" CornerRadius="9" Width="39" Height="39" VerticalAlignment="Center"><Grid><TextBlock Text="TV" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/><views:LazyLogo Url="{Binding Logo}" Width="33" Height="33" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Number,StringFormat={}{0:000}}" Foreground="{DynamicResource Accent}" FontSize="9"/><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Now}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Button>
       <Button Grid.Column="1" Content="{Binding Star}" Command="{Binding DataContext.FavoriteCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" Foreground="{DynamicResource Accent}" Padding="4" FontSize="18" ToolTip="Favoriyi değiştir" AutomationProperties.Name="Favoriyi değiştir"/>
      </Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="EmptyState" Grid.Row="4" Margin="16" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Channels.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <views:Icon Kind="Tv" Width="32" Height="32" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,16"/><TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyDescription}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,18"/>
      <Button Content="Kaynak ekle" Click="AddSource_Click" Style="{StaticResource PrimaryButton}" Visibility="{Binding NeedsSource,Converter={StaticResource BoolVisibility}}"/><Button Content="Aramayı ve filtreyi temizle" Command="{Binding ClearFilterCommand}" Visibility="{Binding HasFilter,Converter={StaticResource BoolVisibility}}"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Style="{StaticResource VodOnly}">
    <Border x:Name="CatalogPanel" DataContext="{Binding Vod}" Background="{DynamicResource Panel}" Padding="14" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" ToolTip="Kataloğu yenile" Style="{StaticResource IconButton}" AutomationProperties.Name="Yenile"><views:Icon Kind="Refresh" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><ComboBox x:Name="AccountChoice" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" DisplayMemberPath="Name" ToolTip="Xtream hesabı"/></DockPanel>
     <Grid Grid.Row="1"><TextBox x:Name="CatalogSearch" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="İçerik adına göre ara" AutomationProperties.Name="Film veya dizi ara" Margin="0,10"/><TextBlock Text="Film veya dizi ara…" Margin="12,0" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <ComboBox Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" ToolTip="Kategori"/>
     <DockPanel Grid.Row="3" Margin="2,12"><TextBlock Text="{Binding CountText}"/><Button DockPanel.Dock="Right" Content="İptal" Command="{Binding CancelCommand}" Padding="8,2" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/></DockPanel>
     <ListBox x:Name="CatalogList" Grid.Row="4" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="55" Height="80" Background="{DynamicResource Surface}" CornerRadius="5"><Grid><views:Icon Kind="Play" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><views:LazyLogo Url="{Binding Poster}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="48"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel></Grid>
     </DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel Grid.Row="4" Margin="20" VerticalAlignment="Center" Visibility="{Binding IsEmpty,Converter={StaticResource BoolVisibility}}"><views:Icon Kind="Search" Width="30" Height="30" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,0,0,16"/><TextBlock Text="{Binding EmptyTitle}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding EmptyDescription}" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10"/></StackPanel>
    </Grid></Border>
   </Grid>
  </Grid>

  <!-- Player column: one video surface shared by live TV and movies/series -->
  <Grid Grid.Row="1" Grid.Column="2" x:Name="PlayerPanel">
   <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="150"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="VideoFrame" Background="#050608" CornerRadius="14" ClipToBounds="True"><vlc:VideoView x:Name="Video" MediaPlayer="{Binding ActivePlayer}"><Grid x:Name="VideoOverlay" Background="#01000000" Focusable="True" PreviewKeyDown="Window_KeyDown" MouseMove="Overlay_MouseMove" PreviewMouseDown="Overlay_MouseDown">
    <!-- Live TV: quick start instead of an empty black screen -->
    <StackPanel x:Name="IdleScreen" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="24">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsVod}" Value="False"/><Condition Binding="{Binding PlayingItem}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
     <views:Icon Kind="Tv" Foreground="#B3F36B" Width="40" Height="40" HorizontalAlignment="Center"/>
     <TextBlock Text="Ekran senin." Foreground="#F3F5F7" FontSize="26" HorizontalAlignment="Center" Margin="0,14,0,8"/>
     <StackPanel Visibility="{Binding NeedsSource,Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="İzlemeye başlamak için M3U bağlantısı, dosya veya Xtream hesabı ekle." Foreground="#A3ADBC" TextWrapping="Wrap" TextAlignment="Center"/>
      <Button Content="+ Kaynak ekle" Click="AddSource_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
     </StackPanel>
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ResumeChannel}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="KALDIĞIN YERDEN" Foreground="#B3F36B" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,8"/>
      <Button x:Name="ResumeButton" Command="{Binding PlayCommand}" CommandParameter="{Binding ResumeChannel}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="18,10" AutomationProperties.Name="Son izlenen kanala devam et"><TextBlock TextTrimming="CharacterEllipsis" MaxWidth="420"><Run Text="▶  Devam et · "/><Run Text="{Binding ResumeChannel.Name,Mode=OneWay}"/></TextBlock></Button>
      <ItemsControl ItemsSource="{Binding QuickChannels}" HorizontalAlignment="Center" Margin="0,14,0,0" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.PlayCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Padding="8,6" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"><StackPanel Orientation="Horizontal"><Border Background="{DynamicResource Page}" CornerRadius="6" Width="26" Height="26"><views:LazyLogo Url="{Binding Logo}" Width="22" Height="22" Stretch="Uniform"/></Border><TextBlock Text="{Binding Name}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,2,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
     <TextBlock Text="Listeden bir kanal seç ya da kanal numarasını yaz." Foreground="#919CAC" HorizontalAlignment="Center" Margin="0,18,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding NeedsSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
    <!-- Movies/series: what to do next -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsVod}" Value="True"/><Condition Binding="{Binding Vod.ShowPlayerHint}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
     <views:Icon Kind="Play" Width="40" Height="40" Foreground="#B3F36B" HorizontalAlignment="Center"/><TextBlock Text="Sırada ne var?" FontSize="24" Foreground="#F3F5F7" TextAlignment="Center" Margin="0,14,0,8"/><TextBlock Text="Katalogdan seç, detaylarına bak ve izlemeye başla." TextWrapping="Wrap" TextAlignment="Center" Foreground="#A3ADBC"/>
    </StackPanel>
    <Border x:Name="PlaybackErrorCard" Background="#F0191D24" CornerRadius="12" Padding="20" Margin="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsVod}" Value="False"/><Condition Binding="{Binding PlaybackError}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><TextBlock Text="Yayın açılamadı" Foreground="#FFB899" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding PlaybackText}" Foreground="#F3F5F7" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16"/><Button Content="Yeniden dene" Command="{Binding ReconnectCommand}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Border>
    <Grid Style="{StaticResource VodOnly}">
     <Border x:Name="VodErrorCard" DataContext="{Binding Vod}" Visibility="{Binding PlaybackError,Converter={StaticResource BoolVisibility},FallbackValue=Collapsed}" Background="#F0191D24" CornerRadius="12" Padding="20" Margin="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Yayın açılamadı" Foreground="#FFB899" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding PlaybackText}" Foreground="#F3F5F7" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,16"/><Button Content="Yeniden dene" Command="{Binding PlayCommand}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
    </Grid>
    <Border x:Name="NumberBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E6101216" CornerRadius="10" Padding="18,10" Margin="24"><TextBlock x:Name="NumberText" FontSize="26" Foreground="#B3F36B"/></Border>
    <!-- Fullscreen controls: live TV -->
    <Border x:Name="FullscreenControls" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#EF191D24" CornerRadius="14" Padding="18,12" Margin="24">
     <StackPanel><TextBlock Text="{Binding CurrentName}" Foreground="#F3F5F7" TextTrimming="CharacterEllipsis" MaxWidth="750" FontSize="16" Margin="5,0,5,9"/>
      <StackPanel Orientation="Horizontal">
       <Button Command="{Binding PreviousChannelCommand}" ToolTip="Önceki kanal" AutomationProperties.Name="Önceki kanal" Style="{StaticResource IconButton}"><views:Icon Kind="Previous" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" ToolTip="Oynat / duraklat" Style="{StaticResource IconButton}" AutomationProperties.Name="Oynat / duraklat"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding NextChannelCommand}" ToolTip="Sonraki kanal" AutomationProperties.Name="Sonraki kanal" Style="{StaticResource IconButton}"><views:Icon Kind="Next" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding LastChannelCommand}" ToolTip="Son izlenen kanala dön" Style="{StaticResource IconButton}" AutomationProperties.Name="Son izlenen kanal"><views:Icon Kind="Back" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding StopCommand}" ToolTip="Durdur" Style="{StaticResource IconButton}" AutomationProperties.Name="Durdur"><views:Icon Kind="Stop" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <Button Command="{Binding ReconnectCommand}" ToolTip="Yeniden bağlan" Style="{StaticResource IconButton}" AutomationProperties.Name="Yenile"><views:Icon Kind="Refresh" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
       <CheckBox Content="Sessiz" Foreground="#F3F5F7" IsChecked="{Binding Muted}" Margin="6,0" VerticalAlignment="Center"/>
       <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" AutomationProperties.Name="Tam ekran ses düzeyi"/>
       <Button Click="Fullscreen_Click" ToolTip="Tam ekrandan çık (Esc)" Margin="14,3,3,3" Style="{StaticResource IconButton}" AutomationProperties.Name="Tam ekrandan çık (Esc)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
      </StackPanel>
     </StackPanel>
    </Border>
    <!-- Fullscreen controls: movies/series -->
    <Border x:Name="VodOverlayControls" DataContext="{Binding Vod}" VerticalAlignment="Bottom" Margin="24" Background="#EE191D24" CornerRadius="12" Padding="16" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="{Binding PlayingName}" TextTrimming="CharacterEllipsis" Foreground="#F3F5F7" Margin="0,0,0,8"/>
     <Slider x:Name="FullSeek" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position,Mode=TwoWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp" LostMouseCapture="Seek_LostCapture" IsMoveToPointEnabled="True" AutomationProperties.Name="Tam ekran oynatma konumu"/>
     <DockPanel Margin="0,8,0,0"><Button Content="−10 sn" Click="Rewind_Click"/><Button Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" Style="{StaticResource IconButton}" ToolTip="Oynat / duraklat" AutomationProperties.Name="Oynat / duraklat"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Content="+10 sn" Click="Forward_Click"/><Button Content="Sonraki bölüm" Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasNextEpisode}"/><TextBlock Text="{Binding TimeText}" Foreground="#F3F5F7" VerticalAlignment="Center" Margin="10,0"/><CheckBox Content="Sessiz" IsChecked="{Binding Muted}" Foreground="#F3F5F7" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Width="100" Value="{Binding Volume}" VerticalAlignment="Center"/><Button Click="Fullscreen_Click" HorizontalAlignment="Right" Style="{StaticResource IconButton}" ToolTip="Tam ekrandan çık (Esc)" AutomationProperties.Name="Tam ekrandan çık (Esc)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button></DockPanel>
    </StackPanel></Border>
   </Grid></vlc:VideoView></Border>

   <!-- Controls: mode specific top part, shared picture/audio/subtitle options -->
   <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Margin="0,10,0,0" Padding="6"><StackPanel>
    <WrapPanel Style="{StaticResource LiveOnly}"><Button Command="{Binding PreviousChannelCommand}" ToolTip="Önceki kanal" Style="{StaticResource IconButton}" AutomationProperties.Name="Önceki kanal"><views:Icon Kind="Previous" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Command="{Binding NextChannelCommand}" ToolTip="Sonraki kanal" Style="{StaticResource IconButton}" AutomationProperties.Name="Sonraki kanal"><views:Icon Kind="Next" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Command="{Binding LastChannelCommand}" ToolTip="Son izlenen kanal" Style="{StaticResource IconButton}" AutomationProperties.Name="Son izlenen kanal"><views:Icon Kind="Back" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" ToolTip="Oynat / duraklat (Space)" AutomationProperties.Name="Oynat veya duraklat" Style="{StaticResource IconButton}"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Command="{Binding StopCommand}" ToolTip="Durdur" Style="{StaticResource IconButton}" AutomationProperties.Name="Durdur"><views:Icon Kind="Stop" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Command="{Binding ReconnectCommand}" ToolTip="Yeniden bağlan" Style="{StaticResource IconButton}" AutomationProperties.Name="Yenile"><views:Icon Kind="Refresh" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><CheckBox Content="Sessiz" IsChecked="{Binding Muted}" Margin="6,0" VerticalAlignment="Center"/><Slider Width="70" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" AutomationProperties.Name="Ses düzeyi"/><Button x:Name="FullscreenButton" Click="Fullscreen_Click" HorizontalAlignment="Right" ToolTip="Tam ekran (F11 / Esc)" Style="{StaticResource IconButton}" AutomationProperties.Name="Tam ekran (F11)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button></WrapPanel>
    <Grid Style="{StaticResource VodOnly}">
     <StackPanel x:Name="VodControls" DataContext="{Binding Vod}" Margin="6,4,6,0">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBlock Text="{Binding PlayingName}" ToolTip="{Binding PlayingName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
      <TextBlock Text="{Binding PlaybackText}" FontSize="11" Margin="0,3,0,2"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding PlaybackError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Slider x:Name="Seek" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position,Mode=TwoWay}" IsEnabled="{Binding CanSeek}" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" PreviewKeyUp="Seek_KeyUp" LostMouseCapture="Seek_LostCapture" IsMoveToPointEnabled="True" AutomationProperties.Name="Oynatma konumu"/>
      <WrapPanel Margin="-6,6,0,0"><Button Content="−10 sn" Click="Rewind_Click"/><Button Background="{DynamicResource Accent}" Foreground="{DynamicResource Page}" Command="{Binding PauseCommand}" Style="{StaticResource IconButton}" ToolTip="Oynat / duraklat (Space)" AutomationProperties.Name="Oynat / duraklat"><views:Icon Kind="{Binding PauseIcon}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Command="{Binding StopCommand}" Style="{StaticResource IconButton}" ToolTip="Durdur" AutomationProperties.Name="Durdur"><views:Icon Kind="Stop" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><Button Content="+10 sn" Click="Forward_Click"/><Button Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}" Command="{Binding NextEpisodeCommand}" IsEnabled="{Binding HasNextEpisode}" Style="{StaticResource IconButton}" ToolTip="Sonraki bölüm" AutomationProperties.Name="Sonraki bölüm"><views:Icon Kind="Next" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button><CheckBox Content="Sessiz" IsChecked="{Binding Muted}" Margin="6,0" VerticalAlignment="Center"/><Slider Minimum="0" Maximum="100" Width="85" Value="{Binding Volume}" VerticalAlignment="Center" AutomationProperties.Name="Ses düzeyi"/><Button x:Name="VodFullscreenButton" Click="Fullscreen_Click" ToolTip="Tam ekran (F11)" Style="{StaticResource IconButton}" AutomationProperties.Name="Tam ekran (F11)"><views:Icon Kind="Fullscreen" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button></WrapPanel>
     </StackPanel>
    </Grid>
    <Expander x:Name="PlaybackOptions" Header="Görüntü, ses ve altyazı" Margin="0,4,0,0"><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="Aspect" SelectedIndex="0" SelectionChanged="Aspect_Changed" AutomationProperties.Name="Görüntü oranı" ToolTip="Görüntü oranı" Margin="3"><ComboBoxItem Content="Otomatik"/><ComboBoxItem Content="16:9"/><ComboBoxItem Content="4:3"/><ComboBoxItem Content="21:9"/></ComboBox><ComboBox x:Name="AudioTracks" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="Audio_Changed" AutomationProperties.Name="Ses izi" ToolTip="Ses izi" Margin="3"/><ComboBox x:Name="SubtitleTracks" Grid.Column="2" DisplayMemberPath="Name" SelectionChanged="Subtitle_Changed" AutomationProperties.Name="Altyazı" ToolTip="Altyazı izi" Margin="3"/></Grid></Expander>
   </StackPanel></Border>

   <!-- Live: now playing -->
   <Grid Grid.Row="2">
    <StackPanel Style="{StaticResource LiveOnly}" Margin="0,12,0,10"><TextBlock Text="{Binding PlaybackText}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding PlaybackError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding CurrentName}" ToolTip="{Binding CurrentName}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
   </Grid>

   <!-- Live: EPG · Movies/series: details, seasons and episodes -->
   <Grid Grid.Row="3">
    <Border Style="{StaticResource LiveOnly}" Background="{DynamicResource Panel}" CornerRadius="12" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ŞİMDİ" Foreground="{DynamicResource Accent}" FontSize="10"/><TextBlock Text="{Binding CurrentProgram.Title,TargetNullValue=Program bilgisi yok}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,5"/><TextBlock Text="{Binding CurrentProgram.TimeRange}" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="{Binding CurrentProgram.Description}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Width="1" Background="{DynamicResource Line}"/><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="SIRADAKİ" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="{Binding NextProgram.Title,TargetNullValue=Program bilgisi yok}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,5"/><TextBlock Text="{Binding NextProgram.TimeRange}" Foreground="{DynamicResource Muted}" FontSize="11"/><Button Content="TV rehberini aç →" Click="Guide_Click" Background="Transparent" HorizontalAlignment="Left" Padding="0,7" Foreground="{DynamicResource Accent}" FontSize="11"/></StackPanel></Grid></Border>
    <Grid Style="{StaticResource VodOnly}">
     <Border x:Name="DetailsPanel" DataContext="{Binding Vod}" Margin="0,10,0,0" Background="{DynamicResource Panel}" CornerRadius="12" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="250"/><Style.Triggers><DataTrigger Binding="{Binding IsMovie}" Value="True"><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,15,0">
       <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding ResumeLabel}" Foreground="{DynamicResource Accent}" Margin="0,4"/><WrapPanel><Button x:Name="WatchButton" Content="İzle / devam et" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" Style="{StaticResource PrimaryButton}" Padding="14,8"/><Button Content="Baştan başlat" Command="{Binding RestartCommand}" IsEnabled="{Binding CanPlay}" Padding="9,8"/></WrapPanel></StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="{Binding Detail.Name,TargetNullValue=Katalogdan bir içerik seçin}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail.Summary}" Foreground="{DynamicResource Muted}" Margin="0,6" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding DetailBusy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Detail.Plot}" TextWrapping="Wrap" FontSize="12"/><TextBlock Text="{Binding EpisodePlot}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
      </DockPanel>
      <Grid Grid.Column="1" Visibility="{Binding IsSeries,Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Sezon" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding Season}"/></DockPanel><ListBox x:Name="EpisodeList" Grid.Row="1" ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" Margin="5,8"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>

  <!-- Status line -->
  <Grid Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
   <DockPanel Style="{StaticResource LiveOnly}"><Button Content="İptal" Command="{Binding CancelCommand}" DockPanel.Dock="Right" Padding="9,3" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><ProgressBar Width="65" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
   <Grid Style="{StaticResource VodOnly}"><DockPanel DataContext="{Binding Vod}"><ProgressBar Width="65" Height="3" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Margin="0,0,12,0" Visibility="{Binding Busy,Converter={StaticResource BoolVisibility},FallbackValue=Collapsed}"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Grid>
  </Grid>
 </Grid>
</Window>
