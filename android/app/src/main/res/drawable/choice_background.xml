<?xml version="1.0" encoding="utf-8"?>
<!-- Focused: accent border (same as list rows). Selected (current choice): accent fill. Otherwise a raised surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_surface" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_surface" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
