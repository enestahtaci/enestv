<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same dark palette as the Windows app (EnesTV.App/Views/Theme.cs). -->
    <color name="page">#101216</color>
    <color name="panel">#191D24</color>
    <color name="surface">#242A34</color>
    <color name="text">#F3F5F7</color>
    <color name="muted">#A3ADBC</color>
    <color name="accent">#B3F36B</color>
    <color name="accent_surface">#2C3B20</color>

    <style name="Theme.Enestv" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Enestv.Choice" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/choice_background</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Enestv.Field" parent="">
        <item name="android:layout_width">640dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/choice_background</item>
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
