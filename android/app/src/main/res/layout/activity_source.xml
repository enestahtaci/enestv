<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="54dp">

    <TextView
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:text="@string/source_title"
        android:textColor="@color/text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/source_note"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kindM3u"
            style="@style/Enestv.Choice"
            android:layout_marginEnd="12dp"
            android:text="@string/kind_m3u" />

        <TextView
            android:id="@+id/kindXtream"
            style="@style/Enestv.Choice"
            android:layout_marginEnd="12dp"
            android:text="@string/kind_xtream" />

        <TextView
            android:id="@+id/kindBackup"
            style="@style/Enestv.Choice"
            android:text="@string/kind_backup" />
    </LinearLayout>

    <TextView
        android:id="@+id/backupInfo"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/muted"
        android:textSize="16sp"
        android:visibility="gone" />

    <EditText
        android:id="@+id/backupPassphrase"
        style="@style/Enestv.Field"
        android:hint="@string/backup_passphrase_hint"
        android:inputType="textPassword"
        android:visibility="gone" />

    <EditText
        android:id="@+id/m3uUrl"
        style="@style/Enestv.Field"
        android:hint="@string/m3u_url_hint"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/server"
        style="@style/Enestv.Field"
        android:hint="@string/server_hint"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/username"
        style="@style/Enestv.Field"
        android:hint="@string/username_hint"
        android:inputType="text|textNoSuggestions" />

    <EditText
        android:id="@+id/password"
        style="@style/Enestv.Field"
        android:hint="@string/password_hint"
        android:inputType="textPassword" />

    <TextView
        android:id="@+id/error"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#FFB899"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/save"
        style="@style/Enestv.Choice"
        android:layout_width="640dp"
        android:text="@string/save" />
</LinearLayout>
